% -----------------------------------------------------------------------------
%  Derivations — the web edition folds the algebra away behind a disclosure
%  triangle. On paper it becomes a marked block the reader may skip on a first
%  pass, with the result stated on the rule so skipping costs nothing.
% -----------------------------------------------------------------------------
% \begin{shderivation}{title}{result or empty}
\newenvironment{shderivation}[2]{%
  \begin{tcolorbox}[shblock, colframe=shFoundation, colback=shFoundation!3!white,
                    left=11pt, right=11pt, top=8pt, bottom=8pt]
  {\displayfont\bfseries\fontsize{8}{10}\selectfont\color{shFoundation}%
   \faCalculator\hspace{0.4em}DERIVATION}\hspace{0.6em}%
  {\displayfont\bfseries\fontsize{10}{13}\selectfont\color{shInk}#2}\par
  \ifx\relax#1\relax\else
    \vspace{3pt}{\fontsize{9}{11.5}\selectfont\color{shInkMuted}#1}\par
  \fi
  \vspace{4pt}{\color{shFoundation!25}\rule{\linewidth}{0.4pt}}\vspace{5pt}\par
  \ignorespaces
}{\end{tcolorbox}}

% -----------------------------------------------------------------------------
%  Algorithms — Thrun's numbered-table style, which the book follows so that
%  readers can move between this text and the literature without translating.
% -----------------------------------------------------------------------------
% \begin{shalgorithm}{name}{inputs}{outputs}{complexity}
\newenvironment{shalgorithm}[4]{%
  \begin{tcolorbox}[shblock, colframe=shInk, colback=white,
                    left=11pt, right=11pt, top=7pt, bottom=8pt]
  {\displayfont\bfseries\fontsize{8}{10}\selectfont\color{shInkMuted}ALGORITHM}%
  \hspace{0.5em}{\ttfamily\fontsize{9.5}{12}\selectfont\color{shInk}#1}%
  \ifx\relax#4\relax\else
    \hfill{\displayfont\fontsize{7.5}{9}\selectfont\color{shInkMuted}COST}\
    {\ttfamily\fontsize{8}{10}\selectfont\color{shInkMuted}#4}%
  \fi\par
  \ifx\relax#2\relax\else
    \vspace{2pt}{\fontsize{8.5}{11}\selectfont\color{shInkMuted}%
      \textbf{in}\ \ #2}\par
  \fi
  \ifx\relax#3\relax\else
    {\fontsize{8.5}{11}\selectfont\color{shInkMuted}\textbf{out}\ \ #3}\par
  \fi
  \vspace{4pt}{\color{shSlate200}\rule{\linewidth}{0.4pt}}\vspace{3pt}\par
  \begingroup
  \setlist[enumerate]{leftmargin=20pt, itemsep=1pt, topsep=2pt, parsep=0pt,
                      label={\ttfamily\color{shInkMuted}\footnotesize\arabic*:}}
  \ignorespaces
}{\endgroup\end{tcolorbox}}

